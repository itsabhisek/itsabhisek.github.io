---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts, formatDate } from '../../lib/posts';
export async function getStaticPaths() {
  return (await getPosts()).map(post => ({ params: { id: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
---
<Base title={post.data.title} description={post.data.description}>
  <article>
    <a class="back-link" href="/">← All writing</a>
    <div class="article-heading">
      <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
      <h1>{post.data.title}</h1>
      <p class="lede">{post.data.description}</p>
      <div class="tags">{post.data.tags.map(tag => <span>{tag}</span>)}</div>
    </div>
    <div class="prose"><Content /></div>
  </article>
</Base>
