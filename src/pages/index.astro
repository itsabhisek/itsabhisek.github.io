---
import Base from '../layouts/Base.astro';
import { getPosts, formatDate } from '../lib/posts';
const posts = await getPosts();
---
<Base>
  <section class="intro">
    <p class="eyebrow">THE PERSONAL NOTEBOOK</p>
    <h1>Hi, I'm Abhisek<span>.</span></h1>
    <p class="lede">A space for ideas, notes, and things worth sharing.<br />One thought at a time.</p>
  </section>
  <section aria-labelledby="writing-title">
    <div class="section-heading"><h2 id="writing-title">Latest writing</h2><span>{posts.length} {posts.length === 1 ? 'entry' : 'entries'}</span></div>
    <div class="post-list">
      {posts.map(post => (
        <article class="post-card">
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
          <h3><a href={`/blog/${post.id}/`}>{post.data.title}<span aria-hidden="true"> ↗</span></a></h3>
          <p>{post.data.description}</p>
          <div class="tags">{post.data.tags.map(tag => <span>{tag}</span>)}</div>
        </article>
      ))}
      {posts.length === 0 && <p>The notebook is open. First entry coming soon.</p>}
    </div>
  </section>
</Base>
